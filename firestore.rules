rules_version = '2';

// Mi Bolso (personal) y Bolsos (de la institución).
//
// Personal — cada voluntario lee y escribe sólo su propio árbol:
//   users/{uid}                    perfil (nombre, email, último acceso)
//   users/{uid}/bolso/actual       inventario completo (catálogo + estados)
//   users/{uid}/movimientos/{id}   historial: usos, reposiciones y ajustes
//
// Institución — bolsos compartidos, sólo para el equipo:
//   equipo/{email}                 quién tiene acceso: rol "voluntario" | "gerencia" | "encargado" (+ bolsos: [ids])
//   solicitudes/{email}            pedidos de acceso de quien entra por primera vez
//   bolsos/{id}                    un bolso: nombre, ubicación + inventario
//   bolsos/{id}/movimientos/{id}   su historial, firmado por quien lo hizo (por)
//
// Voluntario (y despacho): ve todos los bolsos, carga usos / reposiciones / ajustes y marca en servicio / fuera de servicio.
// Encargado: lo mismo, pero SÓLO en los bolsos de su lista (equipo/{email}.bolsos); los demás no los puede ni leer.
// Gerencia: ve todo; además crea, renombra y elimina bolsos, edita las listas y maneja el equipo (salvo encargados).
// Administradores (lista fija, igual que ADMINS en lib/config.ts): siempre gerencia; los únicos que nombran
// encargados y les asignan bolsos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function admin() { return verified() && email() in ['urielchirazi@gmail.com']; }
    function miembroDoc() { return /databases/$(database)/documents/equipo/$(email()); }
    function miembro() { return admin() || (verified() && exists(miembroDoc())); }
    function gerencia() { return admin() || (verified() && exists(miembroDoc()) && get(miembroDoc()).data.rol == 'gerencia'); }
    function veTodo() { return admin() || (verified() && exists(miembroDoc()) && get(miembroDoc()).data.rol in ['voluntario', 'gerencia']); }
    function encargadoDe(b) {
      return verified() && exists(miembroDoc()) && get(miembroDoc()).data.rol == 'encargado'
        && b in get(miembroDoc()).data.get('bolsos', []);
    }
    function puede(b) { return veTodo() || encargadoDe(b); }

    /* ---------- Mi Bolso personal ---------- */
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    /* ---------- Equipo ---------- */
    match /equipo/{e} {
      allow read: if gerencia() || (verified() && e == email());
      // encargados (and their bags) are handled only by the administrator
      allow write: if admin()
        || (gerencia()
            && (request.resource == null || (request.resource.data.rol in ['voluntario', 'gerencia'] && !('bolsos' in request.resource.data)))
            && (resource == null || resource.data.rol != 'encargado'));
    }

    match /solicitudes/{e} {
      allow read, delete: if gerencia() || (verified() && e == email());
      allow create, update: if verified() && e == email() && request.resource.data.email == email();
    }

    /* ---------- Bolsos de la institución ---------- */
    match /bolsos/{b} {
      allow read: if puede(b);
      allow create, delete: if gerencia();
      // gerencia cambia todo; un voluntario sólo el estado de los elementos
      allow update: if gerencia()
        || (puede(b)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['valores', 'cant', 'venc', 'actualizado', 'actualizadoPor'])
            && request.resource.data.actualizadoPor.uid == request.auth.uid)
        // cualquiera del equipo marca el bolso en servicio / fuera de servicio (queda firmado)
        || (puede(b)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fueraDeServicio', 'servicioCambio'])
            && request.resource.data.fueraDeServicio is bool
            && request.resource.data.servicioCambio.uid == request.auth.uid);

      match /movimientos/{m} {
        allow read: if puede(b);
        allow create: if puede(b) && request.resource.data.por.uid == request.auth.uid;
        // cada uno puede seguir corrigiendo su propio "ajuste" (o borrarlo si quedó vacío)
        allow update: if puede(b) && resource.data.por.uid == request.auth.uid && request.resource.data.por.uid == request.auth.uid;
        allow delete: if gerencia() || (puede(b) && (resource == null || resource.data.por.uid == request.auth.uid));
      }
    }
  }
}
